{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "System.Net.Http": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "./logs/.log",
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 1048576,
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Automation": ""
  },
  "Shuttle": {
    "Access": {
      "Authorization": {
        "BaseAddress": "http://localhost:5599"
      }
    },
    "Hopper": {
      "Scheduling": {
        "SqlServer": {
          "Schema": "scheduling",
          "CommandTimeout": "00:01:00"
        }
      }
    }
  }
}
